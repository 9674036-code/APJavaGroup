import java.util.LinkedList;
import java.util.Queue;

public class Main {
    public static void main(String[] args) {

        Queue<String> queue = new LinkedList<>();
        queue.add("Render Image");
        queue.add("Save File");
        queue.add("Send Notification");

        System.out.println("Queue: " + queue);

        System.out.println("Next job: " + queue.peek());

        System.out.println("Processing: " + queue.remove());
        System.out.println("Queue after processing: " + queue);

        if (queue.isEmpty()) {
            System.out.println("Queue is empty.");
        } else {
            System.out.println("Queue is not empty.");
        }

        Queue<String> secondQueue = queue;
        secondQueue.add("New Job");
        System.out.println("Original queue: " + queue);
        System.out.println("Second queue: " + secondQueue);
        Queue<String> copiedQueue = new LinkedList<>(queue);

        copiedQueue.add("Copied Job");

        System.out.println("Original after copy: " + queue);
        System.out.println("Copied queue: " + copiedQueue);
    }
}
